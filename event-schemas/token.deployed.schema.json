{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-launch.dev/event-schemas/token.deployed.schema.json",
  "title": "TokenDeployedEvent",
  "description": "Published when a token deployment is confirmed. Unified schema matching GraphQL `tokenDeployed` subscription payload expectations for proper tenant scoping and filtering.",
  "type": "object",
  "schemaVersion": 1,
  "eventType": "token.deployed",
  "anyOf": [
    {
      "description": "Shape published by batchTokenDeployService.ts.",
      "type": "object",
      "properties": {
        "tokenId": { "type": "string", "description": "Primary key of the Token record." },
        "address": { "type": "string", "description": "Deployed contract address." },
        "creator": { "type": "string", "description": "Stellar/Soroban address of the token creator." },
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "decimals": { "type": "integer", "minimum": 0 },
        "initialSupply": {
          "description": "Stringified bigint (string) or raw bigint depending on the publisher."
        },
        "metadataUri": { "type": ["string", "null"] }
      },
      "required": ["schemaVersion", "tokenId", "address", "creator", "name", "symbol", "decimals", "initialSupply"]
    },
    {
      "description": "Shape expected by the GraphQL tokenDeployed subscription (TokenDeployedPayload).",
      "type": "object",
      "properties": {
        "tokenAddress": { "type": "string" },
        "creatorAddress": { "type": "string", "description": "Used for tenant scoping (TenantScopedPayload)." },
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "totalSupply": {
          "description": "Stringified bigint (string) or raw bigint — see TokenDeployedPayload."
        },
        "txHash": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["schemaVersion", "tokenAddress", "creatorAddress", "name", "symbol", "totalSupply", "txHash", "timestamp"]
    }
  },
  "required": ["tokenAddress", "creatorAddress", "name", "symbol", "totalSupply", "txHash", "timestamp"]
}
