# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=nova_user
POSTGRES_PASSWORD=nova_password

# ─── ELK Stack ────────────────────────────────────────────────────────────────
# IMPORTANT: Must be set when using ELK stack. Should NOT use default "changeme" in production.
# See docker-compose.elk.yml — if this is left as "changeme" Elasticsearch, Logstash, and
# Kibana will all start with an insecure default password. Override this before deploying.
ELASTICSEARCH_PASSWORD=changeme

# ─── Backend ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
ADMIN_JWT_SECRET=change-me-admin-in-production
ADMIN_JWT_EXPIRES_IN=8h

# ─── Stellar ─────────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
FACTORY_CONTRACT_ID=

# ─── Stellar Soroban RPC ──────────────────────────────────────────────────────
# Override the Soroban RPC endpoint (defaults to the standard URL for STELLAR_NETWORK)
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ─── Stellar Request / Retry ──────────────────────────────────────────────────
# Per-request timeout in milliseconds (default: 30000)
STELLAR_REQUEST_TIMEOUT=30000
# Maximum number of retry attempts for retryable RPC errors (default: 3)
STELLAR_RETRY_MAX_ATTEMPTS=3
# Initial backoff delay in milliseconds before the first retry (default: 1000)
STELLAR_RETRY_INITIAL_DELAY=1000
# Maximum backoff delay cap in milliseconds (default: 10000)
STELLAR_RETRY_MAX_DELAY=10000
# Exponential backoff multiplier applied between retries (default: 2)
STELLAR_RETRY_BACKOFF_FACTOR=2

# ─── Stellar Rate Limiting ────────────────────────────────────────────────────
# Maximum number of outbound RPC requests allowed per window (default: 100)
STELLAR_RATE_LIMIT_MAX=100
# Rate-limit window duration in milliseconds (default: 60000)
STELLAR_RATE_LIMIT_WINDOW_MS=60000

# ─── Stellar Circuit Breaker ──────────────────────────────────────────────────
# Number of consecutive failures before the circuit opens (default: 5)
STELLAR_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Number of consecutive successes in half-open state before closing (default: 2)
STELLAR_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
# Duration in milliseconds the circuit stays open before trying again (default: 60000)
STELLAR_CIRCUIT_BREAKER_TIMEOUT_MS=60000

# ─── Frontend (Vite build args) ───────────────────────────────────────────────
VITE_NETWORK=testnet
VITE_FACTORY_CONTRACT_ID=
VITE_API_BASE_URL=http://localhost:3001/api
VITE_TOKEN_INFO_API_URL=http://localhost:3001/api/token-info
VITE_LEADERBOARD_API_URL=http://localhost:3001/api/leaderboard
VITE_GOVERNANCE_API_URL=http://localhost:3001/api/governance
VITE_IPFS_API_KEY=
VITE_IPFS_API_SECRET=
