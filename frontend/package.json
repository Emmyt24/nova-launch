{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest run src/test/integration --config vitest.config.ts",
    "test:integration:watch": "vitest src/test/integration --config vitest.config.ts",
    "test:integration:coverage": "vitest run src/test/integration --coverage --config vitest.config.ts",
    "test:e2e": "vitest run src/test/e2e --config vitest.config.ts",
    "test:e2e:lifecycle": "vitest run src/test/e2e/campaign-lifecycle.e2e.test.tsx --config vitest.config.ts",
    "test:e2e:watch": "vitest src/test/e2e --config vitest.config.ts",
    "test:a11y": "vitest run src/test/accessibility --config vitest.config.ts",
    "test:a11y:watch": "vitest src/test/accessibility --config vitest.config.ts",
    "test:a11y:coverage": "vitest run src/test/accessibility --coverage --config vitest.config.ts",
    "test:a11y:report": "pa11y --reporter json --reporter csv http://localhost:5173",
    "test:a11y:ci": "vitest run src/test/accessibility --config vitest.config.ts --reporter=junit --outputFile=test-results/junit-a11y.xml",
    "test:performance": "vitest run src/test/performance --config vitest.config.ts",
    "test:performance:watch": "vitest src/test/performance --config vitest.config.ts",
    "test:contracts:abi": "vitest run src/contracts/__tests__/factoryAbi.snapshot.test.ts --reporter=verbose",
    "test:contracts:abi:watch": "vitest src/contracts/__tests__/factoryAbi.snapshot.test.ts",
    "test:contracts:abi:update": "vitest run src/contracts/__tests__/factoryAbi.snapshot.test.ts -u",
    "analyze": "npm run build:analyze && node scripts/analyze-bundle.js",
    "monitor": "node scripts/performance-monitor.js",
    "perf:monitor": "node scripts/performance-monitor.js",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@sentry/browser": "^10.40.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^15.0.1",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.11",
    "i18next": "^25.8.12",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.6.4",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.10.13",
    "@types/pa11y": "^5.3.7",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "axe-core": "^4.11.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.5.3",
    "globals": "^17.5.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.0",
    "pa11y": "^9.1.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "^4.1.18",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.10",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.18"
  }
}
