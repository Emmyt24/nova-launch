{
  "name": "nova-launch-backend",
  "version": "1.0.0",
  "description": "Nova Launch Admin Dashboard API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch -r ./src/instrumentation.ts src/index.ts",
    "build": "tsc",
    "start": "node -r ./dist/instrumentation.js dist/index.js",
    "test": "vitest",
    "test:pinata-queue": "vitest run src/__tests__/pinataQueue.test.ts --reporter=verbose",
    "test:migration-compatibility": "vitest run src/__tests__/migrationUpgrade.test.ts src/__tests__/projectionMigration.compatibility.test.ts",
    "test:security": "vitest run src/__tests__/security",
    "test:security:auth": "vitest run src/__tests__/security.auth",
    "test:security:arithmetic": "vitest run src/__tests__/security.arithmetic.test.ts",
    "test:security:timing": "vitest run src/__tests__/security.timing.test.ts",
    "test:security:events": "vitest run src/__tests__/security.event.tampering.test.ts",
    "test:security:dos": "vitest run src/__tests__/security.dos.test.ts",
    "test:security:coverage": "vitest run --coverage src/__tests__/security",
    "test:security:scanning": "vitest run src/__tests__/security.dependency-scanning.test.ts",
    "test:txn-propagation": "vitest run src/__tests__/txn-id-propagation.test.ts src/__tests__/correlation-id-propagation.test.ts --reporter=verbose",
    "test:mutation": "vitest run src/__tests__/mutation-testing.framework.test.ts",
    "test:mutation:audit": "stryker run stryker.audit.conf.json",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "type-check": "tsc --noEmit",
    "docs:generate": "tsx scripts/generate-openapi.ts && tsx scripts/generate-docs.ts",
    "generate:event-types": "tsx scripts/generate-event-types.ts",
    "incident:test": "vitest run --config ../monitoring/pagerduty/vitest.config.ts ../monitoring/pagerduty/incident-response.test.ts",
    "test:health-monitor": "vitest run --root ../monitoring/health-checks"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@pinata/sdk": "^2.1.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^5.22.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.1",
    "graphql": "^17.0.2",
    "graphql-http": "^1.22.4",
    "graphql-query-complexity": "^2.0.0",
    "graphql-ws": "^6.0.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "pg": "^8.18.0",
    "prom-client": "15.1.3",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/nock": "^11.1.0",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.7.0",
    "nock": "^14.0.16",
    "prettier": "^3.8.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2",
    "vitest": "^1.1.0"
  }
}
